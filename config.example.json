{
  "httpPort": 443,
  "httpRedirectPort": 80,
  "pfxFile": "C:\\Certs\\your-cert.pfx",
  "audioLogDir": "audio",
  "audioBackupDir": "",
  "recordingIndex": { "mode": "full", "windowDays": 30 },
  "usageLogFile": "usage.csv",
  "whisper": {
    "remoteServers": [],
    "serverBinaryPath": "C:\\path\\to\\whisper.cpp\\build\\bin\\Release\\whisper-server.exe",
    "modelPath": "C:\\path\\to\\whisper.cpp\\models\\ggml-medium.bin",
    "workers": 2,
    "localBasePort": 18910,
    "serverArgs": ["-t", "4"],
    "inferenceParams": {
      "beam_size": 5,
      "best_of": 5
    },
    "timeoutMs": 600000,
    "gapMs": 4000,
    "maxClipMs": 600000,
    "autoTranscribeMinClipMs": 20000,
    "autoTranscribeMaxClipMs": 0,
    "hallucinationFilter": {
      "useDefaults": true,
      "phrases": [],
      "exactPhrases": [],
      "replacement": "[no speech detected]"
    }
  },
  "regions": {
    "California": {
      "Plumas NF": [
        { "streamName": "Admin Net", "udpPort": 51110 },
        { "streamName": "Forest Net", "udpPort": 51160 }
      ],
      "Tahoe NF": [
        { "streamName": "Redundant Ports", "udpPorts": [51740, 51741] },
        { "streamName": "Multicast Net", "udpPorts": [27238, 27288], "multicastAddrs": ["239.7.10.1", ""] }
      ]
    }
  }
}
