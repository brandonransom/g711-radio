{
  "httpPort": 443,
  "httpRedirectPort": 80,
  "pfxFile": "C:\\Certs\\your-cert.pfx",
  "audioLogDir": "audio",
  "audioBackupDir": "",
  "audioBackupDir2": "",
  "recordingIndex": { "mode": "full", "windowDays": 30 },
  "analytics": {
    "dashboardPath": "",
    "dir": "analytics",
    "retentionDays": 90,
    "geoipDatabase": "",
    "locationOverridesFile": ""
  },
  "whisper": {
    "remoteServers": [],
    "remoteModels": {},
    "serverBinaryPath": "C:\\path\\to\\whisper.cpp\\build\\bin\\Release\\whisper-server.exe",
    "modelPath": "C:\\path\\to\\whisper.cpp\\models\\ggml-medium.bin",
    "workers": 2,
    "localBasePort": 18910,
    "serverArgs": ["-t", "4"],
    "inferenceParams": {
      "beam_size": 5,
      "best_of": 5
    },
    "timeoutMs": 600000,
    "gapMs": 4000,
    "maxClipMs": 600000,
    "autoTranscribeMinClipMs": 20000,
    "autoTranscribeMaxClipMs": 0,
    "hallucinationFilter": {
      "useDefaults": true,
      "phrases": [],
      "exactPhrases": [],
      "replacement": "[no speech detected]"
    }
  },
  "streamsFile": "streams.json"
}
